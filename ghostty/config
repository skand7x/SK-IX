adjust-cursor-thickness=5
mouse-hide-while-typing=true

keybind = ctrl+y=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+r=reload_config
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1
keybind = super+plus=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

keybind = super+x=new_split:right
keybind = super+t=new_split:down

keybind = super+l=goto_split:right 
keybind = super+h=goto_split:left 
keybind = super+j=goto_split:down 
keybind = super+k=goto_split:up
keybind = ctrl+x=resize_split:right,10


theme = Catppuccin Mocha


